/* NetworkingAgent Minimalist Enterprise Theme */

Screen {
    background: #0d1117;
    color: #e6edf3;
}

/* Tabbed Navigation Layout */
#main-tabs {
    height: 1fr;
    width: 100%;
}

TabbedContent {
    height: 1fr;
    width: 100%;
}

ContentSwitcher {
    height: 1fr;
    width: 100%;
}

TabPane {
    height: 1fr;
    width: 100%;
    padding: 0;
}

/* Header & Status Bar */
#top-bar {
    dock: top;
    height: 3;
    background: #161b22;
    color: #e6edf3;
    border-bottom: solid #30363d;
    padding: 0 1;
}

#top-title {
    width: 35%;
    text-style: bold;
    color: #38bdf8;
    content-align: left middle;
}

#top-badges {
    width: 65%;
    content-align: right middle;
}

.status-badge {
    padding: 0 1;
    margin: 0 1;
    background: #21262d;
    border: none;
    text-style: bold;
}

.badge-brain {
    color: #bc8cff;
}

.badge-device {
    color: #58a6ff;
}

.badge-hitl {
    color: #f2cc60;
}

/* Home / Welcome Dashboard */
#home-widget {
    height: 1fr;
    width: 100%;
}

#home-container {
    height: 100%;
    width: 100%;
    padding: 1 2;
    overflow-y: auto;
}

#home-status-card {
    margin-bottom: 1;
}

#home-action-grid {
    grid-size: 2 2;
    grid-gutter: 1 1;
    height: 10;
    margin-top: 1;
}

.home-nav-card {
    height: 4;
    width: 100%;
    text-style: bold;
    text-align: center;
    border: round #30363d;
    background: #161b22;
    color: #e6edf3;
    padding: 0 1;
}

.home-nav-card:hover {
    background: #21262d;
    border: round #58a6ff;
    color: #58a6ff;
}

.card-diagnostic:focus, .card-diagnostic:hover {
    border: round #388bfd;
    color: #58a6ff;
}

.card-inventory:focus, .card-inventory:hover {
    border: round #3fb950;
    color: #3fb950;
}

.card-settings:focus, .card-settings:hover {
    border: round #bc8cff;
    color: #bc8cff;
}

.card-audit:focus, .card-audit:hover {
    border: round #d29922;
    color: #d29922;
}

/* View Header Navigation Bars */
#diagnostic-nav-bar, #inventory-top-bar, #audit-top-bar {
    height: 3;
    background: #161b22;
    border-bottom: solid #30363d;
    padding: 0 1;
    margin-bottom: 1;
    align-vertical: middle;
}

#diagnostic-title, #inventory-title, #lbl-audit-header {
    width: 70%;
    text-style: bold;
    color: #38bdf8;
}

#btn-back-to-home, #btn-back-from-inventory, #btn-back-from-audit {
    width: 30%;
    background: #21262d;
    color: #c9d1d9;
    border: round #30363d;
}

#btn-back-to-home:hover, #btn-back-from-inventory:hover, #btn-back-from-audit:hover {
    background: #30363d;
    color: #ffffff;
    border: round #58a6ff;
}

/* Sidebar */
#device-sidebar {
    width: 32;
    height: 100%;
    background: #161b22;
    border-right: solid #30363d;
    padding: 1;
}

#sidebar-title {
    text-style: bold;
    color: #38bdf8;
    margin-bottom: 1;
    text-align: center;
}

#device-list {
    height: 1fr;
    background: transparent;
    border: none;
}

.device-item {
    height: 3;
    padding: 0 1;
    margin-bottom: 1;
    background: #21262d;
    border-left: wide #484f58;
}

.device-item:hover {
    background: #30363d;
    border-left: wide #58a6ff;
}

.device-item.-selected {
    background: #1c2b3e;
    border-left: wide #388bfd;
    color: #ffffff;
    text-style: bold;
}

#btn-add-device {
    width: 100%;
    margin-top: 1;
    background: #238636;
    color: #ffffff;
    text-style: bold;
    border: round #2ea043;
}

/* Diagnostic View */
#main-split {
    height: 100%;
    width: 100%;
}

#diagnostic-workspace {
    height: 100%;
    width: 1fr;
    padding: 1;
}

#diagnostic-container {
    height: 100%;
    width: 100%;
    overflow-y: auto;
}

.section-panel {
    background: #161b22;
    border: round #30363d;
    padding: 0 1;
    margin-bottom: 1;
    align-vertical: middle;
}

#target-device-card {
    height: 3;
    background: #161b22;
    border-left: heavy #38bdf8;
    padding: 0 1;
    margin-bottom: 1;
}

#mode-selector-bar {
    height: auto;
    min-height: 4;
    padding: 0 1;
}

#radio-mode {
    layout: horizontal;
    background: transparent;
    border: none;
}

#radio-mode RadioButton {
    margin-right: 2;
}

.symptom-chips {
    layout: horizontal;
    height: 3;
    margin-bottom: 1;
}

.chip-btn {
    margin-right: 1;
    background: #21262d;
    color: #8b949e;
    border: round #30363d;
    height: 3;
}

.chip-btn:hover {
    background: #30363d;
    color: #ffffff;
    border: round #58a6ff;
}

#symptom-input {
    height: 4;
    background: #0d1117;
    border: round #30363d;
    color: #ffffff;
    margin-bottom: 1;
}

#symptom-input:focus {
    border: round #388bfd;
}

#btn-run-remediation {
    width: 100%;
    background: #238636;
    color: #ffffff;
    text-style: bold;
    height: 3;
    margin-bottom: 1;
    border: round #2ea043;
}

#btn-run-remediation:hover {
    background: #2ea043;
}

#diagnosis-result {
    height: auto;
    max-height: 14;
    background: #161b22;
    border: round #30363d;
    padding: 1;
    margin-bottom: 1;
}

#log-terminal {
    height: 1fr;
    min-height: 8;
    background: #010409;
    border: round #30363d;
    color: #c9d1d9;
    padding: 1;
}

/* Inventory & Audit Views */
#inventory-widget, #audit-widget {
    height: 1fr;
    width: 100%;
}

#inventory-container, #audit-container {
    height: 100%;
    width: 100%;
    padding: 1;
}

#inventory-data-table, #audit-data-table {
    height: 1fr;
    min-height: 10;
    border: round #30363d;
}

.inventory-actions, .audit-actions {
    layout: horizontal;
    height: 3;
    margin-top: 1;
}

.inventory-actions Button, .audit-actions Button {
    margin-right: 1;
    border: round #30363d;
}

/* Modals */
.modal-screen {
    align: center middle;
    background: rgba(1, 4, 9, 0.85);
}

.modal-dialog {
    width: 78;
    height: auto;
    max-height: 90%;
    background: #161b22;
    border: round #388bfd;
    padding: 1 2;
    overflow-y: auto;
}

.modal-title {
    text-style: bold;
    text-align: center;
    color: #38bdf8;
    margin-bottom: 1;
}

.modal-row {
    layout: horizontal;
    height: auto;
    margin-bottom: 1;
}

.modal-col {
    width: 1fr;
    height: auto;
    margin-right: 1;
}

.modal-col-large {
    width: 70%;
    margin-right: 1;
}

.modal-col-small {
    width: 30%;
}

.modal-hitl-dialog {
    width: 82;
    height: auto;
    max-height: 90%;
    background: #161b22;
    border: round #f85149;
    padding: 1 2;
    overflow-y: auto;
}

.modal-actions {
    layout: horizontal;
    height: 3;
    margin-top: 1;
    align-horizontal: right;
}

.modal-actions Button {
    margin-left: 1;
    border: round #30363d;
}
