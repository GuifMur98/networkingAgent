/* NetworkingAgent Minimalist Enterprise Theme */

Screen {
    background: #0d1117;
    color: #e6edf3;
}

/* Tabbed Navigation Layout */
#main-tabs {
    height: 1fr;
    width: 100%;
}

#main-tabs > Tabs {
    display: none;
}

TabbedContent {
    height: 1fr;
    width: 100%;
}

ContentSwitcher {
    height: 1fr;
    width: 100%;
}

TabPane {
    height: 1fr;
    width: 100%;
    padding: 0;
}

/* Header & Status Bar */
#top-bar {
    dock: top;
    height: 1;
    background: #080c14;
    color: #e6edf3;
    border: none;
    padding: 0 1;
}

#top-bar-inner {
    width: 100%;
    height: 1;
    align: center middle;
    content-align: center middle;
}

#top-badges {
    width: 100%;
    height: 1;
    align: center middle;
    content-align: center middle;
}

.status-badge {
    padding: 0 1;
    margin: 0;
    background: transparent;
    border: none;
    text-style: bold;
}

.status-divider {
    color: #38bdf8;
    background: transparent;
    text-style: dim;
    padding: 0;
}

.badge-brain {
    color: #c084fc;
}

.badge-device {
    color: #38bdf8;
}

.badge-hitl {
    color: #4ade80;
}

/* Home / Welcome Dashboard */
#home-widget {
    height: 1fr;
    width: 100%;
}

#home-container {
    height: 100%;
    width: 100%;
    padding: 0 1;
    overflow-y: auto;
    background: #0a0e17;
}

#home-banner {
    height: auto;
    width: 100%;
    margin-bottom: 1;
}

#home-status-card {
    height: auto;
    width: 100%;
    margin-bottom: 1;
}

#home-cards-container {
    height: auto;
    width: 100%;
}

#home-cards-row-top {
    height: 8;
    min-height: 8;
    width: 100%;
    margin-bottom: 1;
}

#home-cards-row-bottom {
    height: 8;
    min-height: 8;
    width: 100%;
    margin-bottom: 1;
}

.home-nav-card {
    width: 1fr;
    height: 100%;
    min-height: 8;
    background: transparent;
    border: none;
    padding: 0;
    margin: 0 1;
}

.home-nav-card:focus {
    background: #0f172a;
    border: none;
}

.home-nav-card:hover {
    background: #0d1527;
    border: none;
}

/* View Header Navigation Bars */
#diagnostic-nav-bar, #config-nav-bar, #automation-top-bar, #inventory-top-bar, #audit-top-bar {
    height: 4;
    min-height: 4;
    background: #161b22;
    border-bottom: solid #30363d;
    padding: 0 1;
    margin-bottom: 1;
    align-vertical: middle;
}

#diagnostic-title, #config-title, #automation-title, #inventory-title, #lbl-audit-header {
    width: 1fr;
    text-style: bold;
    color: #38bdf8;
    content-align: left middle;
}

#btn-back-to-home, #btn-back-from-config, #btn-back-from-automation, #btn-back-from-inventory, #btn-back-from-audit {
    width: 24;
    height: 3;
    background: #21262d;
    color: #c9d1d9;
    border: round #30363d;
    text-align: center;
    content-align: center middle;
}

#btn-back-to-home:hover, #btn-back-from-config:hover, #btn-back-from-automation:hover, #btn-back-from-inventory:hover, #btn-back-from-audit:hover {
    background: #30363d;
    color: #ffffff;
    border: round #58a6ff;
}

/* Sidebar */
#device-sidebar, #device-sidebar-config, .device-sidebar {
    width: 32;
    height: 100%;
    background: #161b22;
    border-right: solid #30363d;
    padding: 1;
}

#sidebar-title {
    text-style: bold;
    color: #38bdf8;
    margin-bottom: 1;
    text-align: center;
}

#device-list {
    height: 1fr;
    background: transparent;
    border: none;
}

.device-item {
    height: 3;
    padding: 0 1;
    margin-bottom: 1;
    background: #21262d;
    border-left: wide #484f58;
}

.device-item:hover {
    background: #30363d;
    border-left: wide #58a6ff;
}

.device-item.-selected {
    background: #1c2b3e;
    border-left: wide #388bfd;
    color: #ffffff;
    text-style: bold;
}

#btn-add-device {
    width: 100%;
    margin-top: 1;
    background: #238636;
    color: #ffffff;
    text-style: bold;
    border: round #2ea043;
}

/* Diagnostic View */
#main-split, #config-split {
    height: 100%;
    width: 100%;
}

#diagnostic-workspace, #troubleshooting-workspace, #configuration-workspace {
    height: 100%;
    width: 1fr;
    padding: 1;
}

#diagnostic-container {
    height: 100%;
    width: 100%;
    overflow-y: auto;
}

.section-panel {
    background: #161b22;
    border: round #30363d;
    padding: 0 1;
    margin-bottom: 1;
    align-vertical: middle;
}

#target-device-card {
    height: 3;
    background: #161b22;
    border-left: heavy #38bdf8;
    padding: 0 1;
    margin-bottom: 1;
}

#mode-selector-bar {
    height: auto;
    min-height: 4;
    padding: 0 1;
}

#radio-mode {
    layout: horizontal;
    background: transparent;
    border: none;
}

#radio-mode RadioButton {
    margin-right: 2;
}

.symptom-chips {
    layout: horizontal;
    height: 3;
    margin-bottom: 1;
}

.chip-btn {
    margin-right: 1;
    background: #21262d;
    color: #8b949e;
    border: round #30363d;
    height: 3;
}

.chip-btn:hover {
    background: #30363d;
    color: #ffffff;
    border: round #58a6ff;
}

#symptom-input {
    height: 4;
    background: #0d1117;
    border: round #30363d;
    color: #ffffff;
    margin-bottom: 1;
}

#symptom-input:focus {
    border: round #388bfd;
}

#btn-run-remediation {
    width: 100%;
    background: #238636;
    color: #ffffff;
    text-style: bold;
    height: 3;
    margin-bottom: 1;
    border: round #2ea043;
}

#btn-run-remediation:hover {
    background: #2ea043;
}

#diagnosis-result {
    height: auto;
    max-height: 14;
    background: #161b22;
    border: round #30363d;
    padding: 1;
    margin-bottom: 1;
}

#log-terminal {
    height: 1fr;
    min-height: 8;
    background: #010409;
    border: round #30363d;
    color: #c9d1d9;
    padding: 1;
}

/* Inventory & Audit Views */
#inventory-widget, #audit-widget {
    height: 1fr;
    width: 100%;
}

#inventory-container, #audit-container {
    height: 100%;
    width: 100%;
    padding: 1;
}

#inventory-data-table, #audit-data-table {
    height: 1fr;
    min-height: 10;
    border: round #30363d;
}

.inventory-actions, .audit-actions {
    layout: horizontal;
    height: 3;
    margin-top: 1;
}

.inventory-actions Button, .audit-actions Button {
    margin-right: 1;
    border: round #30363d;
}

/* Modals */
ModalScreen {
    background: rgba(0, 0, 0, 0.70);
    align: center middle;
}

.modal-dialog {
    width: 78;
    height: auto;
    max-height: 90%;
    background: #161b22;
    border: round #388bfd;
    padding: 1 2;
    overflow-y: auto;
}

.modal-title {
    text-style: bold;
    text-align: center;
    color: #38bdf8;
    margin-bottom: 1;
}

.modal-row {
    layout: horizontal;
    height: auto;
    margin-bottom: 1;
}

.modal-col {
    width: 1fr;
    height: auto;
    margin-right: 1;
}

.modal-col-large {
    width: 70%;
    margin-right: 1;
}

.modal-col-small {
    width: 30%;
}

.modal-hitl-dialog {
    width: 82;
    height: auto;
    max-height: 90%;
    background: #161b22;
    border: round #f85149;
    padding: 1 2;
    overflow-y: auto;
}

.modal-actions {
    layout: horizontal;
    height: 3;
    margin-top: 1;
    align-horizontal: right;
}

.modal-actions Button {
    margin-left: 1;
    border: round #30363d;
}

.provider-help-text {
    color: #8b949e;
    text-style: italic;
    margin-top: 1;
    margin-bottom: 1;
}

/* Configuration View */
#configuration-container {
    height: 100%;
    width: 100%;
    padding: 1;
    overflow-y: auto;
}

#config-target-card {
    height: 3;
    background: #161b22;
    border-left: heavy #3fb950;
    padding: 0 1;
    margin-bottom: 1;
}

#config-request-input {
    height: 4;
    background: #0d1117;
    border: round #30363d;
    color: #ffffff;
    margin-bottom: 1;
}

#config-request-input:focus {
    border: round #3fb950;
}

#btn-run-config {
    width: 100%;
    background: #238636;
    color: #ffffff;
    text-style: bold;
    height: 3;
    margin-bottom: 1;
    border: round #2ea043;
}

#btn-run-config:hover {
    background: #2ea043;
}

#config-plan-result {
    height: auto;
    max-height: 14;
    background: #161b22;
    border: round #30363d;
    padding: 1;
    margin-bottom: 1;
}

#config-log-terminal {
    height: 1fr;
    min-height: 8;
    background: #010409;
    border: round #30363d;
    color: #c9d1d9;
    padding: 1;
}

/* Automation View */
#automation-container {
    height: 100%;
    width: 100%;
    padding: 1;
    overflow-y: auto;
}

#automation-toolbar {
    height: 5;
    min-height: 5;
    padding: 0 1;
    align-vertical: middle;
    margin-bottom: 1;
}

#automation-selectors {
    width: 1fr;
    height: 3;
    align-vertical: middle;
}

#lbl-tpl-picker, #lbl-vendor-picker {
    height: 3;
    content-align: left middle;
    margin-right: 1;
    text-style: bold;
    color: #e6edf3;
}

#lbl-vendor-picker {
    margin-left: 2;
}

#select-template {
    width: 36;
    height: 3;
}

#select-vendor-auto {
    width: 26;
    height: 3;
}

#automation-actions {
    width: auto;
    height: 3;
    align-vertical: middle;
    align-horizontal: right;
}

#btn-validate-script {
    width: 26;
    height: 3;
    background: #21262d;
    color: #58a6ff;
    border: round #388bfd;
    margin-right: 1;
    text-align: center;
    content-align: center middle;
}

#btn-validate-script:hover {
    background: #30363d;
    color: #ffffff;
}

#btn-deploy-batch {
    width: 24;
    height: 3;
    background: #238636;
    color: #ffffff;
    text-style: bold;
    border: round #2ea043;
    text-align: center;
    content-align: center middle;
}

#btn-deploy-batch:hover {
    background: #2ea043;
}

#automation-split {
    height: 1fr;
    min-height: 16;
    width: 100%;
    margin-bottom: 1;
}

#editor-col {
    width: 65%;
    height: 100%;
    margin-right: 1;
}

#devices-and-status-col {
    width: 35%;
    height: 100%;
}

#automation-editor {
    height: 1fr;
    min-height: 12;
    border: round #388bfd;
    background: #0d1117;
    color: #e6edf3;
}

#device-selection-list {
    height: 8;
    border: round #30363d;
    background: #161b22;
    margin-bottom: 1;
}

#syntax-status-card {
    height: auto;
    max-height: 8;
    margin-bottom: 1;
}

#automation-log-terminal {
    height: 1fr;
    min-height: 8;
    background: #010409;
    border: round #30363d;
    color: #c9d1d9;
    padding: 1;
}


/* Sleek Cyberpunk Footer */
Footer {
    background: #080c14;
    color: #cbd5e1;
}

Footer > .footer--key {
    background: transparent;
    color: #fbbf24;
    text-style: bold;
}

Footer > .footer--description {
    background: transparent;
    color: #e2e8f0;
}
