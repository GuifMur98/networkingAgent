/* NetworkingAgent Modern Enterprise TCSS */

Screen {
    background: #0f141c;
    color: #e0e6ed;
}

/* Header & Top Bar */
#top-bar {
    dock: top;
    height: 3;
    background: #182230;
    color: #ffffff;
    border-bottom: heavy #00e5ff;
    padding: 0 1;
}

#top-title {
    width: 35%;
    text-style: bold;
    color: #00e5ff;
    content-align: left middle;
}

#top-status {
    width: 65%;
    content-align: right middle;
    color: #8fa3b8;
}

.status-badge {
    padding: 0 1;
    margin: 0 1;
    background: #253346;
    border: none;
    text-style: bold;
}

.badge-brain {
    color: #d175ff;
}

.badge-device {
    color: #00e5ff;
}

.badge-hitl {
    color: #ffd600;
}

/* Main Container Split */
#main-container {
    height: 1fr;
    layout: horizontal;
}

/* Sidebar */
#sidebar-container {
    width: 34;
    dock: left;
    height: 100%;
    background: #141c27;
    border-right: vkey #233144;
    padding: 1 1;
}

#sidebar-title {
    text-style: bold;
    color: #00e5ff;
    margin-bottom: 1;
    text-align: center;
}

#device-list {
    height: 1fr;
    background: transparent;
    border: none;
}

.device-item {
    height: 3;
    padding: 0 1;
    margin-bottom: 1;
    background: #1b2636;
    border-left: wide #4a6382;
}

.device-item:hover {
    background: #25364e;
    border-left: wide #00e5ff;
}

.device-item.-selected {
    background: #20354e;
    border-left: wide #00e676;
    color: #ffffff;
    text-style: bold;
}

#btn-add-device {
    width: 100%;
    margin-top: 1;
    background: #00b0ff;
    color: #000000;
    text-style: bold;
}

/* Workspace Tabs */
#workspace-tabs {
    height: 100%;
    padding: 1 2;
}

/* Diagnostic View */
.section-panel {
    background: #16202c;
    border: round #293a50;
    padding: 1 2;
    margin-bottom: 1;
}

#target-device-card {
    height: 4;
    background: #1a2533;
    border-left: heavy #00e5ff;
    padding: 0 1;
    margin-bottom: 1;
}

.symptom-chips {
    layout: horizontal;
    height: 3;
    margin-bottom: 1;
}

.chip-btn {
    margin-right: 1;
    background: #253549;
    color: #8fa3b8;
    border: none;
    height: 3;
}

.chip-btn:hover {
    background: #344a66;
    color: #ffffff;
}

#symptom-input {
    height: 5;
    background: #111722;
    border: tall #2b3d54;
    color: #ffffff;
    margin-bottom: 1;
}

#symptom-input:focus {
    border: tall #00e5ff;
}

#btn-run-remediation {
    width: 100%;
    background: #00c853;
    color: #000000;
    text-style: bold;
    height: 3;
    margin-bottom: 1;
}

#btn-run-remediation:hover {
    background: #00e676;
}

/* Findings & Log Area */
#diagnosis-result {
    height: auto;
    max-height: 12;
    background: #121820;
    border: round #27374c;
    padding: 1;
    margin-bottom: 1;
}

#log-terminal {
    height: 1fr;
    min-height: 8;
    background: #0a0d14;
    border: round #1e2a3a;
    color: #c9d5e3;
    padding: 1;
}

/* Audit Table */
#audit-table {
    height: 1fr;
    background: #101620;
    border: round #27374c;
}

/* Modals */
.modal-screen {
    align: center middle;
    background: rgba(10, 14, 20, 0.85);
}

.modal-dialog {
    width: 76;
    height: auto;
    max-height: 90%;
    background: #182230;
    border: double #00e5ff;
    padding: 1 2;
}

.modal-title {
    text-style: bold;
    text-align: center;
    color: #00e5ff;
    margin-bottom: 1;
}

.modal-hitl-dialog {
    width: 82;
    height: auto;
    max-height: 90%;
    background: #1e1926;
    border: double #ff1744;
    padding: 1 2;
}

.modal-actions {
    layout: horizontal;
    height: 3;
    margin-top: 1;
    align-horizontal: right;
}

.modal-btn {
    margin-left: 1;
}

.modal-btn-primary {
    background: #00c853;
    color: #000000;
    text-style: bold;
}

.modal-btn-danger {
    background: #d50000;
    color: #ffffff;
    text-style: bold;
}
