
/* Tabbed Content & Panes Layout */
#main-tabs {
    height: 1fr;
    width: 100%;
}

TabbedContent {
    height: 1fr;
    width: 100%;
}

ContentSwitcher {
    height: 1fr;
    width: 100%;
}

TabPane {
    height: 1fr;
    width: 100%;
    padding: 0;
}

#home-widget {
    height: 1fr;
    width: 100%;
}

#inventory-widget {
    height: 1fr;
    width: 100%;
}

#audit-widget {
    height: 1fr;
    width: 100%;
}

#inventory-container, #audit-container {
    height: 100%;
    width: 100%;
    padding: 1;
}

#inventory-data-table, #audit-data-table {
    height: 1fr;
    min-height: 10;
}

/* NetworkingAgent Modern Enterprise TCSS */

Screen {
    background: #0d1117;
    color: #e6edf3;
}

/* Header & Top Bar */
#top-bar {
    dock: top;
    height: 3;
    background: #161b22;
    color: #ffffff;
    border-bottom: heavy #00e5ff;
    padding: 0 1;
}

#top-title {
    width: 35%;
    text-style: bold;
    color: #00e5ff;
    content-align: left middle;
}

#top-badges {
    width: 65%;
    content-align: right middle;
}

.status-badge {
    padding: 0 1;
    margin: 0 1;
    background: #21262d;
    border: none;
    text-style: bold;
}

.badge-brain {
    color: #d2a8ff;
}

.badge-device {
    color: #58a6ff;
}

.badge-hitl {
    color: #f2cc60;
}

/* Home / Welcome View */
#home-container {
    height: 100%;
    padding: 1 2;
    overflow-y: auto;
}

#home-status-card {
    margin-bottom: 1;
}

#home-action-grid {
    grid-size: 2 2;
    grid-gutter: 1 2;
    height: 14;
    margin-top: 1;
}

.home-nav-card {
    height: 6;
    width: 100%;
    text-style: bold;
    text-align: center;
    border: tall #30363d;
    padding: 1;
}

.card-primary {
    background: #1f3a2b;
    color: #3fb950;
    border: tall #2ea043;
}

.card-primary:hover {
    background: #238636;
    color: #ffffff;
}

.card-secondary {
    background: #1c2b3e;
    color: #58a6ff;
    border: tall #388bfd;
}

.card-secondary:hover {
    background: #1f6feb;
    color: #ffffff;
}

.card-settings {
    background: #2b1f3a;
    color: #bc8cff;
    border: tall #8957e5;
}

.card-settings:hover {
    background: #6e40c9;
    color: #ffffff;
}

.card-audit {
    background: #332819;
    color: #d29922;
    border: tall #bb8009;
}

.card-audit:hover {
    background: #9e6a03;
    color: #ffffff;
}

/* Top Navigation Bars in Views */
#diagnostic-nav-bar, #inventory-top-bar, #audit-top-bar {
    height: 3;
    background: #161b22;
    border-bottom: round #30363d;
    padding: 0 1;
    margin-bottom: 1;
    align-vertical: middle;
}

#diagnostic-title, #inventory-title, #lbl-audit-header {
    width: 70%;
    text-style: bold;
    color: #00e5ff;
}

#btn-back-to-home, #btn-back-from-inventory, #btn-back-from-audit {
    width: 30%;
    background: #21262d;
    color: #f0f6fc;
    border: tall #30363d;
}

#btn-back-to-home:hover, #btn-back-from-inventory:hover, #btn-back-from-audit:hover {
    background: #30363d;
    color: #00e5ff;
}

/* Sidebar */
#device-sidebar {
    width: 32;
    height: 100%;
    background: #161b22;
    border-right: vkey #30363d;
    padding: 1;
}

#sidebar-title {
    text-style: bold;
    color: #00e5ff;
    margin-bottom: 1;
    text-align: center;
}

#device-list {
    height: 1fr;
    background: transparent;
    border: none;
}

.device-item {
    height: 3;
    padding: 0 1;
    margin-bottom: 1;
    background: #21262d;
    border-left: wide #484f58;
}

.device-item:hover {
    background: #30363d;
    border-left: wide #58a6ff;
}

.device-item.-selected {
    background: #1f3a2b;
    border-left: wide #3fb950;
    color: #ffffff;
    text-style: bold;
}

#btn-add-device {
    width: 100%;
    margin-top: 1;
    background: #238636;
    color: #ffffff;
    text-style: bold;
}

/* Diagnostic View */
#diagnostic-workspace {
    height: 100%;
    padding: 1;
}

#diagnostic-container {
    height: 100%;
    overflow-y: auto;
}

.section-panel {
    background: #161b22;
    border: round #30363d;
    padding: 0 1;
    margin-bottom: 1;
    height: 3;
    align-vertical: middle;
}

#target-device-card {
    height: 3;
    background: #161b22;
    border-left: heavy #00e5ff;
    padding: 0 1;
    margin-bottom: 1;
}

.symptom-chips {
    layout: horizontal;
    height: 3;
    margin-bottom: 1;
}

.chip-btn {
    margin-right: 1;
    background: #21262d;
    color: #8b949e;
    border: none;
    height: 3;
}

.chip-btn:hover {
    background: #30363d;
    color: #ffffff;
}

#symptom-input {
    height: 4;
    background: #0d1117;
    border: tall #30363d;
    color: #ffffff;
    margin-bottom: 1;
}

#symptom-input:focus {
    border: tall #00e5ff;
}

#btn-run-remediation {
    width: 100%;
    background: #238636;
    color: #ffffff;
    text-style: bold;
    height: 3;
    margin-bottom: 1;
}

#btn-run-remediation:hover {
    background: #2ea043;
}

#diagnosis-result {
    height: auto;
    max-height: 12;
    background: #161b22;
    border: round #30363d;
    padding: 1;
    margin-bottom: 1;
}

#log-terminal {
    height: 1fr;
    min-height: 8;
    background: #010409;
    border: round #30363d;
    color: #c9d1d9;
    padding: 1;
}

/* Inventory & Audit Actions */
.inventory-actions, .audit-actions {
    layout: horizontal;
    height: 3;
    margin-top: 1;
}

.inventory-actions Button, .audit-actions Button {
    margin-right: 1;
}

/* Modals */
.modal-screen {
    align: center middle;
    background: rgba(1, 4, 9, 0.85);
}

.modal-dialog {
    width: 76;
    height: auto;
    max-height: 90%;
    background: #161b22;
    border: double #00e5ff;
    padding: 1 2;
}

.modal-title {
    text-style: bold;
    text-align: center;
    color: #00e5ff;
    margin-bottom: 1;
}

.modal-hitl-dialog {
    width: 84;
    height: auto;
    max-height: 90%;
    background: #1e1520;
    border: double #f85149;
    padding: 1 2;
}

.modal-actions {
    layout: horizontal;
    height: 3;
    margin-top: 1;
    align-horizontal: right;
}

.modal-btn-primary {
    background: #238636;
    color: #ffffff;
    text-style: bold;
}

.modal-btn-danger {
    background: #da3633;
    color: #ffffff;
    text-style: bold;
}
