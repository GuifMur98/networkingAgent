/* NetworkingAgent Cyberpunk Mission Control Enterprise Theme */

Screen {
    background: #080c14;
    color: #e2e8f0;
}

/* Tabbed Navigation Layout */
#main-tabs {
    height: 1fr;
    width: 100%;
}

#main-tabs > Tabs {
    display: none;
}

TabbedContent {
    height: 1fr;
    width: 100%;
}

ContentSwitcher {
    height: 1fr;
    width: 100%;
}

TabPane {
    height: 1fr;
    width: 100%;
    padding: 0;
}

/* Header & Status Bar */
#top-bar {
    dock: top;
    height: 1;
    background: #080c14;
    color: #e2e8f0;
    border: none;
    padding: 0 1;
}

#top-bar-inner {
    width: 100%;
    height: 1;
    align: center middle;
    content-align: center middle;
}

#top-badges {
    width: 100%;
    height: 1;
    align: center middle;
    content-align: center middle;
}

.status-badge {
    padding: 0 1;
    margin: 0;
    background: transparent;
    border: none;
    text-style: bold;
}

.status-divider {
    color: #38bdf8;
    background: transparent;
    text-style: dim;
    padding: 0;
}

.badge-brain {
    color: #c084fc;
}

.badge-device {
    color: #38bdf8;
}

.badge-hitl {
    color: #4ade80;
}

/* Home / Welcome Dashboard */
#home-widget {
    height: 1fr;
    width: 100%;
}

#home-container {
    height: 100%;
    width: 100%;
    padding: 0 1;
    overflow-y: auto;
    background: #080c14;
}

#home-banner {
    height: auto;
    width: 100%;
    margin-bottom: 1;
}

#home-status-card {
    height: auto;
    width: 100%;
    margin-bottom: 1;
}

#home-cards-container {
    height: auto;
    width: 100%;
}

#home-cards-row-top {
    height: 7;
    min-height: 7;
    width: 100%;
    margin-bottom: 1;
}

#home-cards-row-bottom {
    height: 7;
    min-height: 7;
    width: 100%;
    margin-bottom: 0;
}

.home-nav-card {
    width: 1fr;
    height: 100%;
    min-height: 7;
    background: #080c14;
    border: none;
    padding: 0;
    margin: 0 1;
}

.home-nav-card:hover {
    background: #0f172a;
    border: none;
}

.home-nav-card:focus {
    background: #0f172a;
    border: none;
}

/* Global Interactive Button Styles with Cyberpunk Hover & Focus */
Button {
    background: #0d1527;
    color: #e2e8f0;
    border: round #00b4d8;
    height: 3;
    text-style: bold;
}

Button:hover {
    background: #1e293b;
    color: #ffffff;
    border: round #00e5ff;
    text-style: bold;
}

Button:focus {
    background: #0f172a;
    color: #00e5ff;
    border: round #00e5ff;
    text-style: bold;
}

/* Primary Action Buttons */
Button.-primary,
#btn-run-remediation,
#btn-run-config,
#btn-deploy-batch,
#btn-save-vault,
#btn-hitl-approve,
#btn-inv-add,
#btn-refresh-audit,
#btn-add-device {
    background: #0369a1;
    color: #ffffff;
    border: round #00e5ff;
    text-style: bold;
}

Button.-primary:hover,
#btn-run-remediation:hover,
#btn-run-config:hover,
#btn-deploy-batch:hover,
#btn-save-vault:hover,
#btn-hitl-approve:hover,
#btn-inv-add:hover,
#btn-refresh-audit:hover,
#btn-add-device:hover {
    background: #0284c7;
    color: #ffffff;
    border: round #38bdf8;
    text-style: bold;
}

Button.-primary:focus,
#btn-run-remediation:focus,
#btn-run-config:focus,
#btn-deploy-batch:focus,
#btn-save-vault:focus,
#btn-hitl-approve:focus,
#btn-inv-add:focus,
#btn-refresh-audit:focus,
#btn-add-device:focus {
    background: #0ea5e9;
    border: round #a5f3fc;
}

/* Error / Destructive Action Buttons */
Button.-error,
#btn-hitl-reject,
#btn-inv-delete {
    background: #881337;
    color: #ffe4e6;
    border: round #f43f5e;
    text-style: bold;
}

Button.-error:hover,
#btn-hitl-reject:hover,
#btn-inv-delete:hover {
    background: #be123c;
    color: #ffffff;
    border: round #fb7185;
    text-style: bold;
}

Button.-error:focus,
#btn-hitl-reject:focus,
#btn-inv-delete:focus {
    background: #e11d48;
    border: round #fda4af;
}

/* Secondary & Back Navigation Buttons */
#btn-back-to-home,
#btn-back-from-config,
#btn-back-from-automation,
#btn-back-from-inventory,
#btn-back-from-audit,
#btn-validate-script,
#btn-inv-refresh,
#btn-cancel {
    background: #080c14;
    color: #38bdf8;
    border: round #00b4d8;
    text-style: bold;
}

#btn-back-to-home:hover,
#btn-back-from-config:hover,
#btn-back-from-automation:hover,
#btn-back-from-inventory:hover,
#btn-back-from-audit:hover,
#btn-validate-script:hover,
#btn-inv-refresh:hover,
#btn-cancel:hover {
    background: #0f172a;
    color: #00e5ff;
    border: round #00e5ff;
    text-style: bold;
}

#btn-back-to-home:focus,
#btn-back-from-config:focus,
#btn-back-from-automation:focus,
#btn-back-from-inventory:focus,
#btn-back-from-audit:focus,
#btn-validate-script:focus,
#btn-inv-refresh:focus,
#btn-cancel:focus {
    background: #1e293b;
    border: round #38bdf8;
}

/* View Header Navigation Bars */
#diagnostic-nav-bar,
#config-nav-bar,
#automation-top-bar,
#inventory-top-bar,
#audit-top-bar {
    height: 4;
    min-height: 4;
    background: #080c14;
    border-bottom: solid #00b4d8;
    padding: 0 1;
    margin-bottom: 1;
    align-vertical: middle;
}

#diagnostic-title,
#config-title,
#automation-title,
#inventory-title,
#lbl-audit-header {
    width: 1fr;
    text-style: bold;
    color: #00e5ff;
    content-align: left middle;
}

#btn-back-to-home,
#btn-back-from-config,
#btn-back-from-automation,
#btn-back-from-inventory,
#btn-back-from-audit {
    width: 24;
    height: 3;
    text-align: center;
    content-align: center middle;
}

/* Sidebar Styling */
#device-sidebar,
#device-sidebar-config,
.device-sidebar {
    width: 32;
    height: 100%;
    background: #080c14;
    border-right: solid #00b4d8;
    padding: 1;
}

#sidebar-title {
    text-style: bold;
    color: #00e5ff;
    margin-bottom: 1;
    text-align: center;
}

#device-list {
    height: 1fr;
    background: transparent;
    border: none;
}

.device-item {
    height: 3;
    padding: 0 1;
    margin-bottom: 1;
    background: #0d1527;
    border-left: wide #1e293b;
}

.device-item:hover {
    background: #0f172a;
    border-left: wide #00e5ff;
    color: #ffffff;
}

.device-item.-selected {
    background: #1e293b;
    border-left: wide #00e5ff;
    color: #38bdf8;
    text-style: bold;
}

#btn-add-device {
    width: 100%;
    margin-top: 1;
}

/* Workspaces Layout */
#main-split,
#config-split {
    height: 100%;
    width: 100%;
}

#diagnostic-workspace,
#troubleshooting-workspace,
#configuration-workspace {
    height: 100%;
    width: 1fr;
    padding: 1 2 1 1;
    background: #080c14;
}

#diagnostic-container,
#configuration-container,
#automation-container,
#inventory-container,
#audit-container {
    height: 100%;
    width: 100%;
    overflow-y: auto;
    background: #080c14;
    padding: 1;
}

.workspace-content-wrapper,
#diagnostic-content-wrapper,
#config-content-wrapper,
#automation-content-wrapper {
    height: auto;
    width: 100%;
    padding: 0 2;
}

/* Section Panels & Target Cards */
.section-panel {
    background: #0d1527;
    border: round #00b4d8;
    padding: 0 1;
    margin-bottom: 1;
    align-vertical: middle;
}

#target-device-card,
#config-target-card {
    height: 3;
    background: #0d1527;
    border-left: heavy #00e5ff;
    border: round #1e293b;
    padding: 0 1;
    margin-bottom: 1;
}

#config-target-card {
    border-left: heavy #4ade80;
}

#mode-selector-container {
    height: auto;
    background: #0d1527;
    border: round #00b4d8;
    padding: 1;
    margin-bottom: 1;
}

#mode-selector-header {
    height: auto;
    align-vertical: middle;
    margin-bottom: 1;
}

#mode-selector-bar {
    height: auto;
    min-height: 3;
    padding: 0 1;
}

#mode-description-banner {
    height: auto;
    background: #080c14;
    border-left: thick #00e5ff;
    padding: 1;
    color: #94a3b8;
}

#lbl-mode,
#lbl-config-proto,
#lbl-quick-symptoms,
#lbl-symptom,
#lbl-config-prompt,
#lbl-console,
#lbl-config-console,
#lbl-editor {
    color: #38bdf8;
    text-style: bold;
    margin-bottom: 1;
}

/* Radio Sets & Radio Buttons */
#radio-mode {
    layout: horizontal;
    background: transparent;
    border: none;
}

#radio-mode RadioButton {
    margin-right: 2;
    color: #94a3b8;
}

#radio-mode RadioButton:hover {
    color: #00e5ff;
}

#radio-mode RadioButton.-selected {
    color: #38bdf8;
    text-style: bold;
}

/* Symptom & Protocol Quick Chips */
#symptom-chips-container,
#proto-chips-container {
    height: auto;
    width: 100%;
    margin-bottom: 1;
}

.symptom-chips-row,
.proto-chips-row {
    height: 3;
    width: 100%;
    margin-bottom: 1;
}

.symptom-chips-row .chip-btn,
.proto-chips-row .chip-btn {
    width: 1fr;
    height: 3;
    margin-right: 1;
    background: #080c14;
    color: #94a3b8;
    border: round #1e293b;
    text-align: center;
    content-align: center middle;
}

.symptom-chips-row .chip-btn:last-child,
.proto-chips-row .chip-btn:last-child {
    margin-right: 0;
}

.symptom-chips-row .chip-btn:hover,
.proto-chips-row .chip-btn:hover {
    background: #0f172a;
    color: #00e5ff;
    border: round #00e5ff;
    text-style: bold;
}

.symptom-chips-row .chip-btn:focus,
.proto-chips-row .chip-btn:focus {
    background: #1e293b;
    color: #00e5ff;
    border: round #00e5ff;
}

.symptom-chips {
    layout: horizontal;
    height: 3;
    margin-bottom: 1;
}

.chip-btn {
    margin-right: 1;
    background: #080c14;
    color: #94a3b8;
    border: round #1e293b;
    height: 3;
}

.chip-btn:hover {
    background: #0f172a;
    color: #38bdf8;
    border: round #00e5ff;
    text-style: bold;
}

.chip-btn:focus {
    background: #1e293b;
    color: #00e5ff;
    border: round #00e5ff;
}

/* Text Inputs and TextAreas */
Input,
TextArea {
    background: #080c14;
    border: round #1e293b;
    color: #e2e8f0;
}

Input:hover,
TextArea:hover {
    background: #0a0e1a;
    border: round #00b4d8;
}

Input:focus,
TextArea:focus {
    background: #0f172a;
    border: round #00e5ff;
    color: #ffffff;
}

#symptom-input,
#config-request-input {
    height: 6;
    margin-bottom: 1;
}

#btn-run-remediation,
#btn-run-config {
    width: 100%;
    margin-bottom: 1;
}

/* Diagnosis & Plan Results */
#diagnosis-result,
#config-plan-result {
    display: none;
    height: auto;
    max-height: 24;
    border: none;
    padding: 0;
    margin-bottom: 1;
}

/* Terminals and Execution Logs */
#telemetry-progress-container,
#config-progress-container {
    height: auto;
    width: 100%;
    margin-bottom: 1;
}

#telemetry-progress-header,
#config-progress-header {
    height: auto;
    width: 100%;
    align-vertical: middle;
}

#lbl-telemetry-step,
#lbl-config-step {
    width: 1fr;
    text-align: right;
    margin-right: 2;
    color: #94a3b8;
}

#lbl-telemetry-pct,
#lbl-config-pct {
    width: 8;
    text-align: right;
    color: #00e5ff;
    text-style: bold;
}

#telemetry-progress-bar,
#config-progress-bar {
    width: 100%;
    height: 1;
    margin-top: 0;
    margin-bottom: 0;
    background: #080c14;
}

#telemetry-progress-bar Bar,
#config-progress-bar Bar {
    width: 1fr;
}

#telemetry-progress-bar Bar > .bar--bar,
#config-progress-bar Bar > .bar--bar {
    color: #00e5ff;
    background: #0d1e38;
}

#telemetry-progress-bar Bar > .bar--complete,
#config-progress-bar Bar > .bar--complete {
    color: #4ade80;
    background: #080c14;
}

#log-terminal,
#config-log-terminal,
#automation-log-terminal {
    height: 15;
    min-height: 12;
    background: #050811;
    border: round #00b4d8;
    color: #a5f3fc;
    padding: 1;
    margin-bottom: 1;
}

/* Automation Suite */
#automation-toolbar {
    height: 5;
    min-height: 5;
    background: #0d1527;
    border: round #00b4d8;
    padding: 0 1;
    align-vertical: middle;
    margin-bottom: 1;
}

#automation-selectors-row {
    width: 1fr;
    height: 3;
    align-vertical: middle;
}

.auto-field-pair {
    width: auto;
    height: 3;
    align-vertical: middle;
    margin-right: 2;
}

.auto-field-label {
    width: auto;
    height: 3;
    content-align: left middle;
    text-style: bold;
    color: #00e5ff;
    margin-right: 1;
}

#select-template {
    width: 36;
    height: 3;
}

#select-vendor-auto {
    width: 24;
    height: 3;
}

#tpl-crud-buttons {
    width: auto;
    height: 3;
    align-vertical: middle;
    align-horizontal: right;
}

#tpl-crud-buttons .chip-btn {
    height: 3;
    min-width: 9;
    margin-left: 1;
    background: #080c14;
    border: round #00b4d8;
    color: #38bdf8;
    text-style: bold;
}

#tpl-crud-buttons .chip-btn:hover {
    border: round #00e5ff;
    color: #ffffff;
    background: #0e2038;
}

#tpl-variables-card {
    height: auto;
    background: #080c14;
    border: round #00b4d8;
    padding: 1;
    margin-bottom: 1;
}

#tpl-vars-header {
    height: 3;
    align-vertical: middle;
    margin-bottom: 1;
}

#lbl-tpl-vars {
    width: 1fr;
    color: #38bdf8;
    text-style: bold;
    content-align: left middle;
}

#btn-render-variables {
    width: 26;
    height: 3;
    text-align: center;
    content-align: center middle;
}

#tpl-vars-form {
    height: auto;
    width: 100%;
}

.tpl-vars-form-row {
    height: 3;
    width: 100%;
    margin-bottom: 1;
    align-vertical: middle;
}

.tpl-var-field-group {
    width: 1fr;
    height: 3;
    align-vertical: middle;
    margin-right: 2;
}

.tpl-var-field-group-spacer {
    width: 1fr;
    height: 3;
    border: none;
    background: transparent;
}

.tpl-var-label {
    width: 18;
    color: #00e5ff;
    text-style: bold;
    content-align: left middle;
}

.tpl-var-field-group Input {
    width: 1fr;
    height: 3;
    border: round #00b4d8;
    background: #050811;
    color: #e2e8f0;
}

.tpl-var-field-group Input:focus {
    border: round #00e5ff;
}

#automation-split {
    height: auto;
    width: 100%;
    margin-bottom: 1;
}

#editor-col {
    width: 11fr;
    height: auto;
    margin-right: 2;
}

#devices-and-status-col {
    width: 9fr;
    height: auto;
}

#lbl-editor {
    height: 3;
    content-align: left middle;
    text-style: bold;
    color: #00e5ff;
}

#automation-editor {
    height: 20;
    border: round #00b4d8;
    background: #080c14;
    color: #e2e8f0;
}

#automation-editor:focus {
    border: round #00e5ff;
}

#devices-header-row {
    height: 3;
    align-vertical: middle;
}

#lbl-target-devices {
    width: 1fr;
    color: #00e5ff;
    text-style: bold;
    content-align: left middle;
}

#btn-select-all-devices,
#btn-deselect-all-devices {
    width: 12;
    height: 3;
    min-height: 3;
    margin-left: 1;
    background: #080c14;
    border: round #00b4d8;
    color: #38bdf8;
    text-style: bold;
    text-align: center;
    content-align: center middle;
}

#btn-select-all-devices:hover,
#btn-deselect-all-devices:hover {
    border: round #00e5ff;
    color: #ffffff;
    background: #0e2038;
}

#device-selection-list {
    height: 8;
    border: round #00b4d8;
    background: #080c14;
    margin-bottom: 1;
}

#device-selection-list:hover {
    border: round #00e5ff;
}

#lbl-syntax-header {
    height: 2;
    content-align: left middle;
    text-style: bold;
    color: #00e5ff;
}

#syntax-status-card {
    height: 9;
    min-height: 9;
    max-height: 9;
    margin-bottom: 0;
}

#automation-actions {
    height: 3;
    margin-top: 1;
    margin-bottom: 1;
    align-vertical: middle;
    align-horizontal: center;
}

#btn-validate-script {
    width: 28;
    height: 3;
    margin-right: 2;
    text-align: center;
    content-align: center middle;
}

#btn-deploy-batch {
    width: 36;
    height: 3;
    text-align: center;
    content-align: center middle;
}

#auto-progress-container {
    height: auto;
    margin-top: 1;
    margin-bottom: 0;
}

#auto-progress-header {
    height: 2;
    align-vertical: middle;
}

#lbl-auto-console {
    width: 1fr;
    color: #00e5ff;
    text-style: bold;
}

#lbl-auto-step {
    width: auto;
    color: #a5f3fc;
    margin-right: 2;
}

#lbl-auto-pct {
    width: auto;
    color: #00e5ff;
    text-style: bold;
}

#auto-progress-bar {
    height: 1;
    margin-bottom: 1;
}

/* Template Modal Dialog */
#template-modal-dialog {
    width: 94;
    height: auto;
    max-height: 90%;
    background: #0a0e17;
    border: round #00e5ff;
    padding: 1 2;
    overflow-y: auto;
}

.tpl-modal-row-split {
    layout: horizontal;
    height: auto;
    margin-bottom: 1;
}

.tpl-modal-col-name {
    width: 3fr;
    height: auto;
    margin-right: 2;
}

.tpl-modal-col-vendor {
    width: 2fr;
    height: auto;
}

#select-tpl-vendor {
    width: 100%;
    height: 3;
}

/* Template Variable Guide Card */
.tpl-guide-card {
    height: auto;
    background: #080c14;
    border-left: thick #00e5ff;
    border: round #1e293b;
    padding: 0 1;
    margin-bottom: 1;
}

#tpl-guide-header {
    height: 2;
    align-vertical: middle;
}

#lbl-guide-title {
    width: 1fr;
    color: #00e5ff;
    text-style: bold;
}

#lbl-guide-syntax {
    width: auto;
    color: #38bdf8;
    text-style: bold;
}

#lbl-guide-desc {
    color: #94a3b8;
    margin-bottom: 1;
}

#tpl-chips-row {
    height: 3;
    align-vertical: middle;
    margin-bottom: 0;
}

#lbl-chips-tag {
    width: auto;
    color: #cbd5e1;
    text-style: bold;
    margin-right: 1;
    content-align: left middle;
}

.tpl-var-chip {
    height: 3;
    min-width: 9;
    margin-right: 1;
    background: #0d1527;
    border: round #00b4d8;
    color: #38bdf8;
    text-style: bold;
    text-align: center;
    content-align: center middle;
}

.tpl-var-chip:hover {
    background: #0e2038;
    border: round #00e5ff;
    color: #ffffff;
}

#modal-editor-row {
    height: auto;
    width: 100%;
    margin-bottom: 1;
}

#modal-editor-header {
    height: 3;
    align-vertical: middle;
}

#lbl-modal-editor {
    width: 1fr;
    color: #00e5ff;
    text-style: bold;
    content-align: left middle;
}

#btn-detect-vars {
    width: 22;
    height: 3;
    margin-left: 1;
    text-align: center;
    content-align: center middle;
}

#input-tpl-content {
    height: 11;
    border: round #00b4d8;
    background: #050811;
    color: #e2e8f0;
}

#input-tpl-content:focus {
    border: round #00e5ff;
}

#lbl-tpl-feedback {
    height: auto;
    min-height: 2;
    padding: 0 1;
    margin-top: 0;
    margin-bottom: 1;
    content-align: left middle;
}

#btn-save-tpl {
    width: 22;
    height: 3;
}

#btn-cancel-tpl {
    width: 14;
    height: 3;
}

/* DataTables for Inventory and Audit */
#inventory-widget,
#audit-widget {
    height: 1fr;
    width: 100%;
}

#inventory-data-table,
#audit-data-table {
    height: 1fr;
    min-height: 10;
    border: round #00b4d8;
    background: #080c14;
}

DataTable > .datatable--header {
    background: #0d1527;
    color: #00e5ff;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: #1e293b;
    color: #ffffff;
    text-style: bold;
}

DataTable > .datatable--hover {
    background: #0f172a;
}

.inventory-actions,
.audit-actions {
    layout: horizontal;
    height: 3;
    margin-top: 1;
}

.inventory-actions Button,
.audit-actions Button {
    margin-right: 1;
}

/* Select Dropdown & Overlays */
Select {
    height: 3;
    border: none;
    background: transparent;
    padding: 0;
    margin: 0;
}

Select:hover,
Select:focus {
    border: none;
}

SelectCurrent {
    border: round #00b4d8;
    background: #080c14;
    color: #e2e8f0;
    height: 3;
    padding: 0 1;
}

SelectCurrent:hover {
    border: round #00e5ff;
    color: #00e5ff;
}

SelectCurrent:focus {
    border: round #00e5ff;
}

SelectOverlay {
    background: #080c14;
    border: round #00e5ff;
}

OptionList {
    background: #080c14;
}

OptionList > .option-list--option:hover {
    background: #0f172a;
    color: #00e5ff;
    text-style: bold;
}

OptionList > .option-list--option.-selected {
    background: #1e293b;
    color: #38bdf8;
    text-style: bold;
}

/* Modals */
ModalScreen {
    background: rgba(8, 12, 20, 0.85);
    align: center middle;
}

.modal-dialog {
    width: 84;
    height: auto;
    max-height: 90%;
    background: #0a0e17;
    border: round #00e5ff;
    padding: 1 2;
    overflow-y: auto;
}

.modal-title {
    text-style: bold;
    text-align: center;
    color: #00e5ff;
    margin-bottom: 1;
}

.modal-row {
    layout: horizontal;
    height: auto;
    margin-bottom: 1;
}

.modal-col {
    width: 1fr;
    height: auto;
    margin-right: 1;
}

.modal-col-large {
    width: 72%;
    height: auto;
    margin-right: 1;
}

.modal-col-small {
    width: 28%;
    height: auto;
}

.modal-hitl-dialog {
    width: 82;
    height: auto;
    max-height: 90%;
    background: #0a0e17;
    border: round #f43f5e;
    padding: 1 2;
    overflow-y: auto;
}

.modal-actions {
    layout: horizontal;
    height: 3;
    margin-top: 1;
    align-horizontal: right;
}

.modal-actions Button {
    margin-left: 1;
}

.provider-help-text {
    color: #38bdf8;
    text-style: italic;
    margin-top: 1;
    margin-bottom: 1;
}

#btn-scan-models {
    width: 100%;
    height: 3;
    background: #080c14;
    border: round #00b4d8;
    color: #38bdf8;
    content-align: center middle;
}

#btn-scan-models:hover {
    background: #0f172a;
    border: round #00e5ff;
    color: #ffffff;
    text-style: bold;
}

.model-status-text {
    margin-top: 0;
    margin-bottom: 1;
    height: auto;
}

Checkbox:hover {
    color: #00e5ff;
}

Checkbox.-on {
    color: #4ade80;
}

.error-label {
    color: #f43f5e;
    text-style: bold;
    margin-top: 1;
}

/* Sleek Cyberpunk Footer */
Footer {
    background: #080c14;
    color: #cbd5e1;
}

Footer > .footer--key {
    background: transparent;
    color: #fbbf24;
    text-style: bold;
}

Footer > .footer--description {
    background: transparent;
    color: #e2e8f0;
}
