# =====================================================================
# NetworkingAgent Environment Configuration Template
# =====================================================================

# AI Brain Configuration
# Options: ollama, gemini, openai, anthropic
AI_PROVIDER=ollama
AI_MODEL=netexpert:latest
OLLAMA_HOST=http://localhost:11434

# Cloud AI API Keys (Optional, required only if using cloud providers)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Network Credentials (Used by Netmiko/SSH)
NET_USER=admin
NET_PASS=your_secure_device_password_here

# Security & Guardrails Policies
ENFORCE_GUARDRAILS=true
AUTO_ROLLBACK_ON_FAILURE=true
SSH_TIMEOUT=30
